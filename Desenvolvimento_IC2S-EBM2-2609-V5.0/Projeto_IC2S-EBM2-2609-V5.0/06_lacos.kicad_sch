		(at 60.96 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5ba52549-b900-4eec-93d9-370d2528e911")
	)
	(text "2. TVS: D12-D17 36 V no terminal apos o fusivel (rev. 2.3); D6-D11 33 V no retorno (rev. 2.4: grampo 53,3 V < 55 V)."
		(exclude_from_sim no)
		(at 60.96 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b7a7beed-26dc-441f-9d54-6530ad7ab602")
	)
	(text "3. Rev. 2.4: protector TPS26613 no retorno, copiado da EBM7 V2.3 (Legacy U8-U11). MODE=GND: 25-40 mA durante"
		(exclude_from_sim no)
		(at 60.96 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3c70804-65e3-4df2-9667-b383948489df")
	)
	(text "   100 ms, corta e tenta de novo a cada 800 ms. Em curto a leitura alterna 4095 e ~0 mA. SGOOD sem uso."
		(exclude_from_sim no)
		(at 60.96 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c2461841-94c6-4fe0-8918-ef3b74a76956")
	)
	(text "4. +12V_TPS pelo U14 (Legacy U12). VSNS 13k3/3k325: limiar 5,0 V (a Legacy tem 11k5, 4,46 V: 1,4 % de margem)."
		(exclude_from_sim no)
		(at 60.96 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "094d42fc-820c-4421-b0bc-3f01ea1a5e6e")
	)
	(text "5. Prova: 20 mA x 110 ohm = 2,200 V; saturacao a 22,7 mA. A 18 V sobram >= 14,76 V ao transmissor."
		(exclude_from_sim no)
		(at 60.96 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6f4110b2-a100-430c-931f-8213baa8fe00")
	)
	(text "6. Rev. 2.5: R28-R33 4k7 no pino do ADC (30 uA em curto); C32 e C33 no U14."
		(exclude_from_sim no)
		(at 60.96 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f5a5291-19fb-49c1-ba36-bb17e54f25c1")
	)
