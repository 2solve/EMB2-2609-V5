	(text "DECISOES DESTA FOLHA (F2 2.2b - intencao_EBM2_V5.md rev.2, sec. 7)"
		(exclude_from_sim no)
		(at 25.4 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c03b57a1-404b-4cee-b14c-d735fb91ae37")
	)
	(text "1. U6 ISO7141CCDBQR: pinagem conferida na figura da sec. 5, pag. 4, do SLLSE83F."
		(exclude_from_sim no)
		(at 25.4 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "44b6391c-1177-4099-9d1c-1feddee0c113")
	)
	(text "   A mesma pagina traz o ISO7131 e o ISO7140 com os pinos 5, 6, 11 e 12 trocados."
		(exclude_from_sim no)
		(at 25.4 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "890ebc39-0f8e-4508-abdd-bb068a214d60")
	)
	(text "   Simbolo da EBM7 V2.3 Legacy (EBM7_V23_proyecto4:ISO7141CC), copiado sem alteracoes."
		(exclude_from_sim no)
		(at 25.4 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "96e1766d-e50b-454f-b045-acfc2146ecf4")
	)
	(text "2. VCC1 a 3,3 V pelo U5, nao a 5 V: fecha o G2. A 5 V o OUTD punha ~4,9 V"
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a640c532-7fdb-4ca3-8678-9f6c16695caf")
	)
	(text "   no GPIO9 da Raspberry Pi, acima do maximo dela, sem resistencia serie."
		(exclude_from_sim no)
		(at 25.4 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "90737ad3-7e76-4e15-9a00-a6e435b9fead")
	)
	(text "3. U5 MCP1824T-3302E/OT SOT-23-5 (28-09-2026, era MCP1824S SOT-223): mesmo MPN do U4; pinos pag. 2 do DS22070A;"
		(exclude_from_sim no)
		(at 25.4 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c8bdd72-55d4-4b34-bb50-5b0d8cf127e2")
	)
	(text "   entrada 2,1-6,0 V; estavel com >= 1 uF ceramico (pag. 1); C11 = 2,2 uF. SHDN a VIN, PG aberto."
		(exclude_from_sim no)
		(at 25.4 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b6f76ee-9051-4765-9800-0a8c1260a211")
	)
	(text "4. VCC2 pela ferrite FB1 a partir de 3V3_REF, como na V4.1."
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63e85112-63fa-42be-ac78-0ca0976e4875")
	)
	(text "5. TP8 em DGND do lado do barramento: uma sonda do lado de campo com a placa"
		(exclude_from_sim no)
		(at 25.4 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "73b3cd08-90a9-4f20-9565-fe47479f2d1c")
	)
	(text "   ligada atravessava a separacao pela massa do osciloscopio."
		(exclude_from_sim no)
		(at 25.4 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
