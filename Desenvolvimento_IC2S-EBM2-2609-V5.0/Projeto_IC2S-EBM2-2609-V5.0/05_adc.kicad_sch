	(label "VDD_ADC"
		(at 144.78 62.23 90)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8bb9f8eb-bdd1-46ae-8313-4175cdb30028")
	)
	(text "DECISOES DESTA FOLHA (F2 2.2b - intencao_EBM2_V5.md rev.2, sec. 8)"
		(exclude_from_sim no)
		(at 25.4 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2a775bcb-4dd9-40b1-9e22-577d3dbe5c92")
	)
	(text "1. U7 MCP3208T-BI/SL: grau B, INL +-1 LSB (DS21298E pag. 37). Mesma pinagem que o -CI."
		(exclude_from_sim no)
		(at 25.4 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c49e0a50-72ee-42ee-85b4-7c12a6000628")
	)
	(text "2. MAPA DE CANAIS CONGELADO (RC4), igual a V4.1: CH0-CH3 campo 1-4, CH4 termistor,"
		(exclude_from_sim no)
		(at 25.4 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "604718bd-c524-4213-8b21-89d28cadc1e3")
	)
	(text "   CH5 preso a 3V3_REF (le sempre 4095), CH6-CH7 campo 5-6. Nao e sequencial."
		(exclude_from_sim no)
		(at 25.4 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3992554a-4516-403f-892a-2c61826799a3")
	)
	(text "3. VREF = +2V5_REF (ADR4525), ja nao o VDD. C14 100 nF no pino."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dc61c0c1-5463-4579-a787-194425c79a78")
	)
	(text "4. VDD pela ferrite FB2 com 1 uF + 100 nF no pino (sec. 6.4, pag. 23)."
		(exclude_from_sim no)
		(at 25.4 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "340e2875-61aa-41c9-80d6-5e7c01959808")
	)
	(text "5. AGND e DGND vao os dois a GND_ADC, com percursos proprios no layout."
		(exclude_from_sim no)
		(at 25.4 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "25c493a5-016d-4ac0-9464-c578aac54844")
	)
	(text "6. FIRMWARE: SPI <= 1 MHz (2 MHz so garantido a VDD 5 V). Transaccao de 24 bits"
		(exclude_from_sim no)
		(at 25.4 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "76ec0ef1-175b-471f-8ec6-d04456bd7b46")
	)
	(text "   atomica: a 85 C a amostra so dura 1,2 ms (sec. 6.2). Cadencia <= 4 kHz por canal."
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "60bb3ea7-ab0a-46a2-a791-f9e378a41940")
	)
